{
  "name": "lista-de-jogos",
  "version": "1.0.0",
  "private": true,
  "description": "Lista de jogos que já joguei — site estático retrô 8/16-bit para GitHub Pages",
  "scripts": {
    "lint": "eslint . && stylelint \"assets/css/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"assets/css/**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "thumbs": "node tools/make-thumbs.mjs",
    "check": "npm run format:check && npm run lint",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "prettier": "^3.3.0",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1"
  }
}
